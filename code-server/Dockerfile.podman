# Production stage — quay.io/podman/stable (Fedora-based)
FROM quay.io/podman/stable AS production

ARG UID=1000
ARG GID=1000
ARG NAME=vscode
ARG PORT=3000
ARG RELEASE=latest

# ── Node.js LTS via NodeSource ────────────────────────────────────────────────
RUN curl -fsSL https://rpm.nodesource.com/setup_lts.x | bash -

# ── Runtime dependencies ──────────────────────────────────────────────────────
RUN dnf install -y \
      ca-certificates \
      curl \
      dumb-init \
      git \
      git-lfs \
      htop \
      glibc-langpack-en \
      man-db \
      nano \
      openssh-clients \
      python3 \
      nodejs \
      procps-ng \
      vim-minimal \
      wget \
      ripgrep \
      lsb-release \
      shadow-utils \
      tar \
      gzip \
      findutils \
      bash \
    && git lfs install \
    && dnf clean all

# ── uv ───────────────────────────────────────────────────────────────────────
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ── Locale ───────────────────────────────────────────────────────────────────
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# ── Podman storage config: vfs by default (no kernel features needed) ─────────
RUN mkdir -p /etc/containers \
    && cat > /etc/containers/storage.conf <<'EOF'
[storage]
  driver = "vfs"
  runroot = "/run/containers/storage"
  graphroot = "/var/lib/containers/storage"

[storage.options]
  # vfs needs no special kernel support — safe inside unprivileged containers
  [storage.options.vfs]
EOF

# Also set for rootless user (will be copied to $HOME later)
RUN mkdir -p /etc/containers && cat > /etc/containers/registries.conf <<'EOF'
[registries.search]
registries = ["docker.io", "quay.io", "ghcr.io"]
EOF

# ── docker → podman shim ──────────────────────────────────────────────────────
RUN cat > /usr/local/bin/docker <<'EOF'
#!/bin/bash
# Transparent docker CLI → podman wrapper
exec podman "$@"
EOF
RUN chmod +x /usr/local/bin/docker

# ── kilocode CLI ─────────────────────────────────────────────────────────────
RUN npm install -g @kilocode/cli

# ── User setup ────────────────────────────────────────────────────────────────
RUN set -eux; \
    if [ "${UID}" = "0" ] && [ "${GID}" = "0" ] && [ "${NAME}" = "root" ]; then \
        :; \
    else \
        if getent group "${GID}" >/dev/null 2>&1; then \
            existing_group="$(getent group "${GID}" | cut -d: -f1)"; \
            if [ "${existing_group}" != "${NAME}" ]; then \
                groupmod -n "${NAME}" "${existing_group}"; \
            fi; \
        else \
            groupadd -g "${GID}" "${NAME}"; \
        fi; \
        if getent passwd "${UID}" >/dev/null 2>&1; then \
            existing_user="$(getent passwd "${UID}" | cut -d: -f1)"; \
            if [ "${existing_user}" != "${NAME}" ]; then \
                usermod -l "${NAME}" "${existing_user}"; \
                usermod -d "/vscode" -m "${NAME}" 2>/dev/null || true; \
                usermod -g "${NAME}" "${NAME}"; \
            fi; \
        else \
            useradd -r -u "${UID}" -g "${NAME}" -d "/vscode" -s /bin/bash "${NAME}"; \
        fi; \
        grep -q "^${NAME}:" /etc/subuid || echo "${NAME}:100000:65536" >> /etc/subuid; \
        grep -q "^${NAME}:" /etc/subgid || echo "${NAME}:100000:65536" >> /etc/subgid; \
    fi

# ── code-server via RPM ───────────────────────────────────────────────────────
RUN set -eux; \
    if [ "$RELEASE" = "latest" ]; then \
      TAG=$(curl -sSL https://api.github.com/repos/coder/code-server/releases/latest \
            | grep '"tag_name"' \
            | sed -E 's/.*"([^"]+)".*/\1/'); \
    else \
      TAG=$RELEASE; \
    fi; \
    TAG="${TAG#v}"; \
    ARCH=$(uname -m); \
    case "$ARCH" in \
      x86_64)  CS_ARCH="amd64" ;; \
      aarch64) CS_ARCH="arm64" ;; \
      *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
    esac; \
    RPM_URL="https://github.com/coder/code-server/releases/download/v${TAG}/code-server-${TAG}-${CS_ARCH}.rpm"; \
    wget -qO /tmp/code-server.rpm "$RPM_URL"; \
    rpm -i /tmp/code-server.rpm; \
    rm -f /tmp/code-server.rpm

# ── Workdir & ownership ───────────────────────────────────────────────────────
WORKDIR /vscode
RUN chown -R ${NAME}:${NAME} /vscode

USER ${NAME}

# ── Rootless podman storage config for user ───────────────────────────────────
RUN mkdir -p ~/.config/containers \
    && cat > ~/.config/containers/storage.conf <<'EOF'
[storage]
  driver = "vfs"
  runroot = "/tmp/podman-run"
  graphroot = "/vscode/.local/share/containers/storage"
EOF

EXPOSE ${PORT}

ENV SHELL=/bin/bash \
    NODE_ENV=production \
    PORT=${PORT}

RUN mkdir -p /vscode/workspace

CMD if [ -d "~/entrypoint.d" ]; then \
      find "~/entrypoint.d" -type f -executable -print -exec {} \; ; \
    fi && \
    if [ -d "/entrypoint.d" ]; then \
      find "/entrypoint.d" -type f -executable -print -exec {} \; ; \
    fi && \
    exec dumb-init /usr/bin/code-server \
      --bind-addr 0.0.0.0:${PORT} \
      --user-data-dir ~/.vscode \
      --auth none \
      /vscode/workspace "$@"
