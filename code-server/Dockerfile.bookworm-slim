# https://github.com/coder/code-server/blob/aff005e19626ac6802223713fa569e743c125725/ci/release-image/Dockerfile
# Production stage
FROM node:lts-bookworm-slim AS production

ARG UID=1000
ARG GID=1000
ARG NAME=vscode
ARG PORT=3000
ARG RELEASE=latest

ENV DEBIAN_FRONTEND=noninteractive

# ── Runtime dependencies (kept in sync with Dockerfile.podman) ────────────────
# Debian package names: python3-dev / libffi-dev / golang-go / procps /
# vim-tiny / openssh-client. liboqs has no Debian bookworm package — it is
# only available in the Fedora-based Dockerfile.podman.
RUN apt-get update \
  && apt-get install -y \
    ca-certificates \
    curl \
    dumb-init \
    git \
    git-lfs \
    gh \
    htop \
    locales \
    lsb-release \
    man-db \
    nano \
    openssh-client \
    python3 \
    python3-dev \
    python3-pip \
    npm \
    procps \
    vim-tiny \
    wget \
    ripgrep \
    tmux \
    golang-go \
    gcc \
    libffi-dev \
  && git lfs install \
  && rm -rf /var/lib/apt/lists/*

# ── glab CLI (not packaged in Debian bookworm) ───────────────────────────────
RUN set -eux; \
    TAG=$(curl -fsSL "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/releases/permalink/latest" \
          | python3 -c "import json,sys; print(json.load(sys.stdin)['tag_name'])"); \
    TAG="${TAG#v}"; \
    ARCH=$(dpkg --print-architecture); \
    curl -fsSL -o /tmp/glab.deb \
      "https://gitlab.com/gitlab-org/cli/-/releases/v${TAG}/downloads/glab_${TAG}_linux_${ARCH}.deb"; \
    apt-get update && apt-get install -y /tmp/glab.deb; \
    rm -f /tmp/glab.deb; \
    rm -rf /var/lib/apt/lists/*

# ── uv ───────────────────────────────────────────────────────────────────────
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ── Docker CLI + smart router (kept in sync with Dockerfile.podman) ───────────
# Real docker CLI (matches the DinD daemon version in docker-compose.yml).
# /usr/local/bin shadows /usr/bin on PATH: requests with DOCKER_HOST set
# (rootless DinD) go to the real CLI, everything else falls back to podman
# if it is ever installed locally.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/bin/docker
RUN cat > /usr/local/bin/docker <<'EOF'
#!/bin/bash
if [ -n "${DOCKER_HOST}" ] || ! command -v podman >/dev/null 2>&1; then
  exec /usr/bin/docker "$@"
fi
exec podman "$@"
EOF
RUN chmod +x /usr/local/bin/docker

# ── Locale ───────────────────────────────────────────────────────────────────
# https://wiki.debian.org/Locale#Manually
RUN sed -i "s/# en_US.UTF-8/en_US.UTF-8/" /etc/locale.gen \
  && locale-gen
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# ── kilocode CLI ─────────────────────────────────────────────────────────────
RUN npm install -g @kilocode/cli

# ── opencode CLI ─────────────────────────────────────────────────────────────
RUN npm install -g opencode-ai@latest

# ── codex CLI ─────────────────────────────────────────────────────────────────
RUN npm install -g @openai/codex

# ── User setup (kept in sync with Dockerfile.podman) ──────────────────────────
RUN set -eux; \
    if [ "${UID}" = "0" ] && [ "${GID}" = "0" ] && [ "${NAME}" = "root" ]; then \
        :; \
    else \
        if getent group "${GID}" >/dev/null 2>&1; then \
            existing_group="$(getent group "${GID}" | cut -d: -f1)"; \
            if [ "${existing_group}" != "${NAME}" ]; then \
                groupmod -n "${NAME}" "${existing_group}"; \
            fi; \
        else \
            groupadd -g "${GID}" "${NAME}"; \
        fi; \
        if getent passwd "${UID}" >/dev/null 2>&1; then \
            existing_user="$(getent passwd "${UID}" | cut -d: -f1)"; \
            if [ "${existing_user}" != "${NAME}" ]; then \
                usermod -l "${NAME}" "${existing_user}"; \
                usermod -d "/vscode" -m "${NAME}" 2>/dev/null || true; \
                usermod -g "${NAME}" "${NAME}"; \
            fi; \
        else \
            useradd -r -u "${UID}" -g "${NAME}" -d "/vscode" -s /bin/bash "${NAME}"; \
        fi; \
        grep -q "^${NAME}:" /etc/subuid || echo "${NAME}:100000:65536" >> /etc/subuid; \
        grep -q "^${NAME}:" /etc/subgid || echo "${NAME}:100000:65536" >> /etc/subgid; \
    fi

# ── code-server via .deb ─────────────────────────────────────────────────────
RUN set -eux; \
    if [ "$RELEASE" = "latest" ]; then \
      TAG=$(curl -sSL https://api.github.com/repos/coder/code-server/releases/latest \
            | grep '"tag_name"' \
            | sed -E 's/.*"([^"]+)".*/\1/'); \
    else \
      TAG=$RELEASE; \
    fi; \
    TAG="${TAG#v}"; \
    ARCH=$(dpkg --print-architecture); \
    DEB_URL="https://github.com/coder/code-server/releases/download/v${TAG}/code-server_${TAG}_${ARCH}.deb"; \
    wget -qO /tmp/code-server.deb "$DEB_URL"; \
    dpkg -i /tmp/code-server.deb; \
    rm -rf /tmp/code-server.deb /var/lib/apt/lists/*

# ── Workdir & ownership ───────────────────────────────────────────────────────
WORKDIR /vscode
RUN chown -R ${NAME}:${NAME} /vscode

USER ${NAME}

EXPOSE ${PORT}

ENV SHELL=/bin/bash \
    NODE_ENV=production \
    PORT=${PORT}

RUN mkdir -p /vscode/workspace

CMD if [ -d "~/entrypoint.d" ]; then \
      find "~/entrypoint.d" -type f -executable -print -exec {} \; ; \
    fi && \
    if [ -d "/entrypoint.d" ]; then \
      find "/entrypoint.d" -type f -executable -print -exec {} \; ; \
    fi && \
    exec dumb-init /usr/bin/code-server \
      --bind-addr 0.0.0.0:${PORT} \
      --user-data-dir ~/.vscode \
      --auth none \
      /vscode/workspace "$@"
